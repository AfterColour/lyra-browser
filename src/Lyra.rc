// Version information shown in Explorer (Properties > Details) and used by the installer.
#include <winver.h>
#include "LyraVersion.h"

// The app icon (drawn by tools/make-icon.ps1). Resource id 1: Explorer, the taskbar and
// shortcuts take the first icon of the exe; main.cpp loads it by this id.
1 ICON "Lyra.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LYRA_VERSION_MAJOR, LYRA_VERSION_MINOR, LYRA_VERSION_PATCH, 0
 PRODUCTVERSION LYRA_VERSION_MAJOR, LYRA_VERSION_MINOR, LYRA_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AfterColour"
            VALUE "FileDescription", "Lyra"
            VALUE "FileVersion", LYRA_VERSION_STR
            VALUE "InternalName", "Lyra"
            VALUE "LegalCopyright", "Copyright (c) 2026 AfterColour"
            VALUE "OriginalFilename", "Lyra.exe"
            VALUE "ProductName", "Lyra"
            VALUE "ProductVersion", LYRA_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
