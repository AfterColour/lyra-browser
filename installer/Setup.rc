// LyraSetup resources: the app icon, the large icon picture for the window, version info.
// (The files to install are added later as the PAYLOAD resource by tools/make-installer.py.)
#include <winver.h>
#include "LyraVersion.h"

1 ICON "Lyra.ico"
ICONPNG RCDATA "lyra-icon-512.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LYRA_VERSION_MAJOR, LYRA_VERSION_MINOR, LYRA_VERSION_PATCH, 0
 PRODUCTVERSION LYRA_VERSION_MAJOR, LYRA_VERSION_MINOR, LYRA_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AfterColour"
            VALUE "FileDescription", "Lyra Setup"
            VALUE "FileVersion", LYRA_VERSION_STR
            VALUE "InternalName", "LyraSetup"
            VALUE "LegalCopyright", "Copyright (c) 2026 AfterColour"
            VALUE "OriginalFilename", "LyraSetup.exe"
            VALUE "ProductName", "Lyra"
            VALUE "ProductVersion", LYRA_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
